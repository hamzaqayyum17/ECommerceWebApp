@model ECommerceApp.Models.Order

<div class="container mt-4">
    <h4>Order #@Model.OrderId Detail</h4>
    <p class="text-muted">
        @Model.OrderDate.ToString("dd MMM yyyy hh:mm tt")
    </p>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card p-3">
                <h6>Customer</h6>
                <p class="mb-0">@Model.UserName</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card p-3">
                <h6>Status</h6>
                <span class="badge bg-warning fs-6">@Model.Status</span>
            </div>
        </div>
    </div>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Product</th>
                <th>Unit Price</th>
                <th>Qty</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <img src="@item.ImageUrl" width="40" height="40"
                             style="object-fit:cover" class="me-2" />
                        @item.Name
                    </td>
                    <td>Rs. @item.UnitPrice</td>
                    <td>@item.Quantity</td>
                    <td>Rs. @item.SubTotal</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-success">
                <th colspan="3">Total</th>
                <th>Rs. @Model.TotalAmount</th>
            </tr>
        </tfoot>
    </table>

    <a asp-action="Orders" class="btn btn-secondary">← Back</a>
</div>
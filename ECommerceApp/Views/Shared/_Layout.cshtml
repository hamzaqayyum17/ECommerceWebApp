<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ECommerceApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ECommerceApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!-- Brand -->
                <a class="navbar-brand fw-bold"
                       asp-controller="Home" asp-action="Index">
                    🛒 ECommerceApp
                </a>

                <!-- Mobile toggle button -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Left side links -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white"
                                   asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>

                        @* Sirf Admin ko Admin Panel link dikhe *@
                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning"
                                       asp-controller="Admin" asp-action="Index">
                                    ⚙️ Admin Panel
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Live Search Bar -->
                    <div class="position-relative me-3" style="width:300px">
                        <input type="text" id="liveSearch"
                               class="form-control form-control-sm"
                               placeholder="🔍 Search products..." />
                        <div id="searchResults"
                             class="list-group position-absolute w-100 shadow"
                             style="display:none; z-index:9999; top:100%">
                        </div>
                    </div>

                    <!-- Right side links -->
                    <ul class="navbar-nav">

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            @* Logged in user *@

                            @* Cart + My Orders — sirf customer ko dikhe *@
                            @if (Context.Session.GetString("Role") == "Customer")
                            {
                                <li class="nav-item me-2">
                                    <a asp-controller="Cart" asp-action="Index"
                                           class="btn btn-outline-light btn-sm mt-1">
                                        🛍️ Cart
                                        <span id="cartBadge"
                                              class="badge bg-danger">0</span>
                                    </a>
                                </li>

                                <li class="nav-item me-2">
                                    <a asp-controller="Order" asp-action="MyOrders"
                                           class="nav-link text-white">
                                        📋 My Orders
                                    </a>
                                </li>
                            }

                            @* Username show karo *@
                            <li class="nav-item me-2">
                                <span class="nav-link text-white">
                                    👤 @Context.Session.GetString("UserName")
                                </span>
                            </li>

                            @* Logout *@
                            <li class="nav-item">
                                <a asp-controller="Account" asp-action="Logout"
                                       class="btn btn-outline-danger btn-sm mt-1">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            @* Guest user *@
                            <li class="nav-item me-2">
                                <a asp-controller="Account" asp-action="Login"
                                       class="btn btn-outline-light btn-sm mt-1">
                                    Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Account" asp-action="Register"
                                       class="btn btn-primary btn-sm mt-1">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-2">
            &copy; 2026 - ECommerceApp
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Cart count load on page load *@
    @if (Context.Session.GetString("Role") == "Customer" &&
         Context.Session.GetInt32("UserId") != null)
    {
        <script>
                fetch('/Cart/GetCartCount')
                    .then(res => res.json())
                    .then(data => {
                        if (data.count > 0)
                            document.getElementById('cartBadge')
                                    .textContent = data.count;
                    });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>